# Copy to .env (git-ignored) or set these in the cloud environment's secrets.
KALSHI_API_KEY_ID=your-key-id-uuid
# Either the full PEM (newlines may be written as \n) ...
KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# ... or a path to the file Kalshi gave you.
# KALSHI_PRIVATE_KEY_PATH=/path/to/kalshi-key.pem

# demo | prod       (demo = Kalshi's play-money exchange)
KALSHI_ENV=demo
# paper | live      (paper = simulate fills locally, place nothing)
TRADING_MODE=paper
